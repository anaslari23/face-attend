<odoo>
    <record id="hr_employee_face_attendance_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.face.attendance.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Face Attendance" groups="face_attendance.group_face_attendance_user">
                    <group>
                        <field name="face_registered" readonly="1"/>
                        <field name="face_registered_date" readonly="1"/>
                        <field name="face_enrollment_count" readonly="1"/>
                        <field name="face_sync_error" readonly="1" invisible="not face_sync_error"/>
                    </group>
                    <group>
                        <button name="action_sync_face_to_middleware" type="object" string="Prepare Avatar For Scanner" class="btn-primary"/>
                        <button name="action_reset_face_enrollment" type="object" string="Reset Face Enrollment" class="btn-secondary"/>
                    </group>
                    <group string="Devices">
                        <field name="face_device_ids" readonly="1" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="device_uid"/>
                                <field name="active"/>
                                <field name="last_seen_at"/>
                                <field name="token_expires_at"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="action_sync_face_to_middleware_multi" model="ir.actions.server">
        <field name="name">Sync Face to Middleware</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
for record in records:
    if record.image_1920:
        record.action_sync_face_to_middleware()
        </field>
    </record>
</odoo>
