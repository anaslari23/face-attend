<odoo>
    <record id="face_attendance_template_view_tree" model="ir.ui.view">
        <field name="name">face.attendance.template.tree</field>
        <field name="model">face.attendance.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="model_version"/>
                <field name="device_uid"/>
                <field name="quality_score"/>
                <field name="active"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="face_attendance_template_view_form" model="ir.ui.view">
        <field name="name">face.attendance.template.form</field>
        <field name="model">face.attendance.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="model_version"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="device_uid"/>
                            <field name="quality_score"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Embedding">
                            <field name="embedding_json" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="face_attendance_device_view_tree" model="ir.ui.view">
        <field name="name">face.attendance.device.list</field>
        <field name="model">face.attendance.device</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="device_type"/>
                <field name="employee_id"/>
                <field name="device_uid"/>
                <field name="active"/>
                <field name="last_seen_at"/>
                <field name="token_expires_at"/>
            </list>
        </field>
    </record>

    <record id="face_attendance_device_view_form" model="ir.ui.view">
        <field name="name">face.attendance.device.form</field>
        <field name="model">face.attendance.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_token" type="object" string="Generate New Token" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="device_type"/>
                            <field name="employee_id"/>
                            <field name="device_uid"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="last_seen_at" readonly="1"/>
                            <field name="token_expires_at"/>
                            <field name="setup_code" readonly="1"/>
                            <field name="token" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="face_attendance_log_view_tree" model="ir.ui.view">
        <field name="name">face.attendance.log.tree</field>
        <field name="model">face.attendance.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Punch Time"/>
                <field name="employee_odoo_id"/>
                <field name="employee_name"/>
                <field name="punch_type" string="Punch Type"/>
                <field name="device_uid" string="Device ID"/>
            </list>
        </field>
    </record>

    <record id="face_attendance_log_view_search" model="ir.ui.view">
        <field name="name">face.attendance.log.search</field>
        <field name="model">face.attendance.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_odoo_id"/>
                <field name="employee_name"/>
                <field name="device_uid" string="Device ID"/>
                <separator/>
                <filter string="Today" name="today" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Employee" name="group_employee" context="{'group_by': 'employee_name'}"/>
                <filter string="Device ID" name="group_device" context="{'group_by': 'device_uid'}"/>
                <filter string="Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

    <record id="face_attendance_log_view_form" model="ir.ui.view">
        <field name="name">face.attendance.log.form</field>
        <field name="model">face.attendance.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="create_date" string="Punch Time" readonly="1"/>
                        <field name="employee_odoo_id" readonly="1"/>
                        <field name="employee_name" readonly="1"/>
                        <field name="punch_type" string="Punch Type" readonly="1"/>
                        <field name="device_uid" string="Device ID" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="face_attendance_log_view_pivot" model="ir.ui.view">
        <field name="name">face.attendance.log.pivot</field>
        <field name="model">face.attendance.log</field>
        <field name="arch" type="xml">
            <pivot string="Face Attendance Attempts">
                <field name="employee_id" type="row"/>
                <field name="accepted" type="col"/>
                <field name="match_score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="face_attendance_log_view_graph" model="ir.ui.view">
        <field name="name">face.attendance.log.graph</field>
        <field name="model">face.attendance.log</field>
        <field name="arch" type="xml">
            <graph string="Face Attendance Attempts" type="bar">
                <field name="create_date" interval="day"/>
                <field name="accepted"/>
            </graph>
        </field>
    </record>

    <record id="face_attendance_config_view_tree" model="ir.ui.view">
        <field name="name">face.attendance.config.list</field>
        <field name="model">face.attendance.config</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="confidence_threshold"/>
                <field name="liveness_required"/>
                <field name="anti_spoofing_required"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="face_attendance_config_view_form" model="ir.ui.view">
        <field name="name">face.attendance.config.form</field>
        <field name="model">face.attendance.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_logs" type="object" string="Open Logs" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Scanner">
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group string="Verification">
                            <field name="confidence_threshold"/>
                            <field name="liveness_required"/>
                            <field name="anti_spoofing_required"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="face_attendance_template_action" model="ir.actions.act_window">
        <field name="name">Face Templates</field>
        <field name="res_model">face.attendance.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="face_attendance_device_action" model="ir.actions.act_window">
        <field name="name">Registered Devices</field>
        <field name="res_model">face.attendance.device</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="face_attendance_log_action" model="ir.actions.act_window">
        <field name="name">Face Attendance Logs</field>
        <field name="res_model">face.attendance.log</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="domain">[('accepted', '=', True)]</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <record id="face_attendance_config_action" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">face.attendance.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
